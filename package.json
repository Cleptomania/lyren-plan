{
  "name": "lyren-plan",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted personal project management: projects, milestones, epics, tasks and configurable boards.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false --tsconfig tsconfig.server.json server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "package:win": "node scripts/package.mjs --target win-x64",
    "package:linux": "node scripts/package.mjs --target linux-x64"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "postject": "1.0.0-alpha.6",
    "resedit": "3.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@hono/node-server": "^1.19.17",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "fractional-indexing": "^3.4.0",
    "hono": "^4.13.9",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  }
}
