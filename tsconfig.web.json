{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["shared/src/*"],
      "@/*": ["web/src/*"]
    }
  },
  "include": ["shared/src", "web/src", "web/vite.config.ts"]
}
